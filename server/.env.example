
# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/dream-ceylon

# Authentication Secrets
# Generate a secure 32+ character random secret for production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Google Cloud OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Module 8: Multi-Currency & Frankfurter Exchange Rate Service Configuration
# Frankfurter API is public and free (no API key required)
FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
CURRENCY_CACHE_TTL_MINUTES=60
LKR_PER_USD_REFERENCE=300

# Module 2: Maps, Routes & Transportation Configurations
# Default engine is free OpenStreetMap + Project OSRM
ROUTING_PROVIDER=osrm
# TOMTOM_API_KEY=your_tomtom_traffic_api_key_optional
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_optional
