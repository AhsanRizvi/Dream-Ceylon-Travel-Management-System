# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/dream-ceylon

# Authentication Secrets
# (Generate a secure 32+ character random secret for production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=30d

# Google Cloud OAuth 2.0 Credentials
# (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Module 2: Maps, Routes & Transportation Configurations (SEU/IS/22/ICT/037)
# Default engine is 100% free OpenStreetMap + Project OSRM (requires NO API keys).
# If live commercial traffic feeds are configured, set optional provider keys below:
ROUTING_PROVIDER=osrm
# TOMTOM_API_KEY=your_tomtom_traffic_api_key_optional
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_optional

