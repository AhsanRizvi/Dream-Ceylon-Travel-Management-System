# Backend API URL (Express server)
VITE_API_URL=http://localhost:5000/api

# Google Cloud OAuth 2.0 Client ID (Public identifier for browser client)
# Obtain from Google Cloud Console under Credentials -> OAuth 2.0 Client IDs (Web application)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional Google Maps JavaScript SDK Key (If omitted, uses OpenStreetMap/Leaflet tiles with zero billing required)
# VITE_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key_optional
